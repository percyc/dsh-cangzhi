{
  "name": "dsh-cangzhi",
  "version": "0.12.0",
  "description": "Standalone DeepSeek Harness adapter for Cangzhi knowledge services",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "DEPLOYMENT.md",
    "HANDOFF.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && node scripts/rewrite-client-id.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-storage": "0.1.2-alpha.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-layout": { "optional": true },
    "@deepseek-ai/dsh-client-ui-chat": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-client-ui-renderer": { "optional": true },
    "@deepseek-ai/dsh-client-ui-sidebar": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings-plugins": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-client-ui-tool": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-storage": { "optional": true },
    "react": { "optional": true }
  },
  "license": "MIT"
}
